FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 8.94;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 8.94;
    }

    outlet
    {
        type            inletOutlet;
        inletValue      uniform 8.94;
        value           $internalField;
    }

    ground
    {
        type            omegaWallFunction;
        value           uniform 8.94;
    }

    ahmed_body
    {
        type            omegaWallFunction;
        value           uniform 8.94;
    }

    roof
    {
        type            slip;
    }

    farSide
    {
        type            slip;
    }

    centerline
    {
        type            symmetry;
    }

}


