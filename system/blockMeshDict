FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   1;

vertices
(
    (-5.5  0.0 0.0) // 0: Inlet, Right, Ground
    (15.0  0.0 0.0) // 1: Outlet, Right, Ground
    (15.0  3.0 0.0) // 2: Outlet, Left, Ground
    (-5.5  3.0 0.0) // 3: Inlet, Left, Ground
    (-5.5  0.0 5.0) // 4: Inlet, Right, Roof
    (15.0  0.0 5.0) // 5: Outlet, Right, Roof
    (15.0  3.0 5.0) // 6: Outlet, Left, Roof
    (-5.5  3.0 5.0) // 7: Inlet, Left, Roof
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (80 30 30) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (1 2 6 5)
        );
    }
    ground
    {
        type wall;
        faces
        (
            (0 3 2 1)
        );
    }
    roof
    {
        type symmetry; //Allows flow to slip, acting like open air
        faces
        (
            (4 5 6 7)
        );
    }
    sides
    {
        type symmetry;
        faces
        (
            (0 1 5 4)
            (3 7 6 2)
        );
    }
);

mergePatchPairs
(
);

