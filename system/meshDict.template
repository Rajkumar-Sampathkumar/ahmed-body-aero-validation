FoamFile
{
    format      ascii;
    class       dictionary;
    object      meshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Tell cfMesh which geometry to carve out
surfaceFile     "ahmed_body_half.stl"

// ========================================================================= //
// PILLAR 1: GLOBAL SCALE
// ========================================================================= //
// This is the maximum cell size (in meters) in the far-field wind tunnel.
// Since our domain is massive (15 meters long), we can let these cells be large 
// to save memory.
maxCellSize  0.4;

// ========================================================================= //
// PILLAR 2: SURFACE REFINEMENT
// ========================================================================= //
// This dictates the baseline cell size directly on the car's surface. 
// We are setting it to 20mm (0.02m) here.
boundaryCellSize  0.02; 

// We tell cfMesh to look specifically at the car and refine sharp edges 
// even further so we don't lose the 25-degree slant angle.
localRefinement
{
    "ahmed_body_half.stl"
    {
        additionalRefinementLevels  1; // Halves the boundary cell size to 10 mm
    }
}

// ========================================================================= //
// PILLAR 3: VOLUME REFINEMENT (THE WAKE)
// ========================================================================= //
// 
// We create an invisible bounding box behind the car. 
// We force the cells inside this box to be small enough to capture the 
// C-pillar trailing vortices.
objectRefinements
{
    wakeBox
    {
        type box;
        // NOTE: These coordinates assume your car's rear base is near X = 1.0.
        // It draws a box starting near the rear window, extending 3 meters back.
        pMin  (0.8 0.0 0.0)
        pMax  (4.0 0.6 0.6)
        cellSize  0.04; // 40mm cells in the wake
    }
}

// ========================================================================= //
// PILLAR 4: BOUNDARY LAYERS (PYTHON HOOK)
// ========================================================================= //
// We only want layers on the car. We absolutely DO NOT want layers on the 
// symmetry plane or the wind tunnel walls.
boundaryLayers
{
    // By default, turn layers OFF everywhere
    nLayers  0;

    patchBoundaryLayers
    {
        // Turn layers ON only for the car surface
        "ahmed_body_half.stl"
        {
            nLayers _NUM_LAYERS_; // Total number of prism layers
            thicknessRatio _THICKNESS_RATIO_; // How quickly they grow (20% per layer)

            // This is the exact placeholder where the python script looks for
            maxFirstLayerThickness _FIRST_LAYER_THICKNESS_;

            allowPointsOnMultipleMacroEdges  0; // Prevents layer collapse on sharp corners
        }
    }
}
