FoamFile
{
    format      ascii;
    class       dictionary;
    object      meshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// ========================================================================= //
// 1. BASE DOMAIN (THE WIND TUNNEL)
// ========================================================================= //
surfaceFile "constant/triSurface/domain.stl";
maxCellSize 0.4;

// Tell cfMesh to keep the cells touching the inlet. 
// This forces it to mesh the air volume and hollow out the car.
keepCellsIntersectingPatches
(
    "inlet"
);

// ========================================================================= //
// 2. SECONDARY SURFACE (THE CAR)
// ========================================================================= //
surfaceMeshRefinement 
{
    ahmed_body
    {
        surfaceFile "constant/triSurface/ahmed_body_half.stl"
        cellSize 0.02;
        additionalRefinementLevels 1;
    }
}

// We tell cfMesh to look specifically at the car and refine sharp edges 
// even further so we don't lose the 25-degree slant angle.
// localRefinement
// {
    // "ahmed_body_half*"
    // {
        // additionalRefinementLevels 1; // Halves the boundary cell size to 10 mm
    // }
// }

// ========================================================================= //
// 3. WAKE REFINEMENT
// ========================================================================= //
// 
// We create an invisible bounding box behind the car. 
// We force the cells inside this box to be small enough to capture the 
// C-pillar trailing vortices.
objectRefinements
{
    wakeBox
    {
        type box;
        // NOTE: These coordinates assume your car's rear base is near X = 1.0.
        // It draws a box starting near the rear window, extending 3 meters back.
        centre (2.4 0.3 0.3);
        lengthX 3.2;
        lengthY 0.6;
        lengthZ 0.6;
        cellSize 0.04; // 40mm cells in the wake
    }
}

// ========================================================================= //
// 4: BOUNDARY LAYERS (PYTHON HOOK)
// ========================================================================= //
// We only want layers on the car. We absolutely DO NOT want layers on the 
// symmetry plane or the wind tunnel walls.
boundaryLayers
{
    // By default, turn layers OFF everywhere
    nLayers 0;

    patchBoundaryLayers
    {
        // Turn layers ON only for the car surface
        "ahmed_body_half.stl"
        {
            nLayers 15; // Total number of prism layers
            thicknessRatio 1.2; // How quickly they grow (20% per layer)

            // This is the exact placeholder where the python script looks for
            maxFirstLayerThickness 9.879475e-06;

            allowPointsOnMultipleMacroEdges 0; // Prevents layer collapse on sharp corners
        }
    }
}

// ========================================================================= //
// 5. PATCH CLEANUP
// ========================================================================= //
renameBounday
{
    defaultName     defaultFaces;
    defaultType     patch;

    newPatchNames
    {
        "ahmed_body_half.stl"
        {
            newName     ahmed_body;
            type        wall;
        }
        "inlet"
        {
            newName     inlet;
            type        patch;
        }
        "outlet"
        {
            newName     outlet;
            type        patch;
        }
        "ground"
        {
            newName     ground;
            type        wall;
        }
        "roof"
        {
            newName     roof;
            type        symmetry;
        }
        "farSide"
        {
            newName     farSide;
            type        symmetry;
        }
        "centerline"
        {
            newName     centerline;
            type        symmetryPlane;
        }
    }
}
